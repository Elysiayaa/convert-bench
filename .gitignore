# Frontend / 前端依赖与构建产物
frontend/node_modules/
frontend/.next/
frontend/.next-*/
frontend/out/
frontend/.env*.local

# Backend / Python 缓存与虚拟环境
backend/.venv/
backend/venv/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Runtime data / 运行时数据

# 忽略用户上传和转换输出，但保留数据集
backend/data/*
!backend/data/.gitkeep

backend/storage/uploads/
backend/storage/outputs/
backend/storage/tmp/

# 保留数据集
!backend/storage/datasets/
!backend/storage/datasets/*.jsonl

# Environment / 环境变量
.env
.env.local

# IDE & OS / 编辑器与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs / 日志
*.log
